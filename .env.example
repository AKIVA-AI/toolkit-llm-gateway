# ============================================================================
# AKIVA LLM Gateway - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://akiva:akiva_password@localhost:5432/akiva_gateway

# For SQLite (development only):
# DATABASE_URL=sqlite:///./akiva_gateway.db

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION (RECOMMENDED)
# ----------------------------------------------------------------------------
# Server host and port
HOST=0.0.0.0
PORT=12000

# Environment (development, staging, production)
ENVIRONMENT=development

# ----------------------------------------------------------------------------
# LLM PROVIDER API KEYS (RECOMMENDED)
# ----------------------------------------------------------------------------
# At least one provider API key is recommended for full functionality

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=sk-...

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI API Key (for Gemini models)
# GOOGLE_API_KEY=...

# Cohere API Key
# COHERE_API_KEY=...

# Replicate API Key
# REPLICATE_API_KEY=...

# HuggingFace API Key
# HUGGINGFACE_API_KEY=...

# ----------------------------------------------------------------------------
# COST TRACKING (RECOMMENDED)
# ----------------------------------------------------------------------------
# Enable/disable cost tracking features
ENABLE_COST_TRACKING=true

# Default budget limits (USD)
DEFAULT_TEAM_BUDGET=1000.00
DEFAULT_PROJECT_BUDGET=500.00
DEFAULT_USER_BUDGET=100.00

# Budget alert thresholds (percentage)
BUDGET_WARNING_THRESHOLD=80
BUDGET_CRITICAL_THRESHOLD=95

# ----------------------------------------------------------------------------
# SECURITY (RECOMMENDED FOR PRODUCTION)
# ----------------------------------------------------------------------------
# Secret key for signing webhooks and sessions
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# API key for gateway authentication (optional)
# GATEWAY_API_KEY=your-gateway-api-key

# Enable/disable authentication
REQUIRE_AUTHENTICATION=false

# ----------------------------------------------------------------------------
# REDIS CACHE (OPTIONAL)
# ----------------------------------------------------------------------------
# Redis connection string for caching
# REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds
# CACHE_TTL=3600

# ----------------------------------------------------------------------------
# LOGGING (OPTIONAL)
# ----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json

# Log file path (leave empty for stdout only)
# LOG_FILE=/var/log/akiva-gateway/app.log

# ----------------------------------------------------------------------------
# MONITORING & METRICS (OPTIONAL)
# ----------------------------------------------------------------------------
# Enable Prometheus metrics endpoint
# ENABLE_METRICS=true

# Metrics port (if different from main server)
# METRICS_PORT=9090

# Sentry DSN for error tracking
# SENTRY_DSN=https://...@sentry.io/...

# ----------------------------------------------------------------------------
# WEBHOOKS (OPTIONAL)
# ----------------------------------------------------------------------------
# Default webhook timeout in seconds
WEBHOOK_TIMEOUT=30

# Maximum webhook retries
WEBHOOK_MAX_RETRIES=3

# Webhook retry delay in seconds
WEBHOOK_RETRY_DELAY=60

# ----------------------------------------------------------------------------
# RATE LIMITING (OPTIONAL)
# ----------------------------------------------------------------------------
# Enable rate limiting
# ENABLE_RATE_LIMITING=true

# Default rate limit (requests per minute)
# DEFAULT_RATE_LIMIT=60

# ----------------------------------------------------------------------------
# ADVANCED SETTINGS (OPTIONAL)
# ----------------------------------------------------------------------------
# Database connection pool size
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Request timeout in seconds
REQUEST_TIMEOUT=300

# Enable debug mode (DO NOT USE IN PRODUCTION)
DEBUG=false

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://app.example.com

# ----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS (OPTIONAL)
# ----------------------------------------------------------------------------
# Enable SQL query logging
# SQL_ECHO=false

# Enable auto-reload on code changes
# AUTO_RELOAD=true

# ============================================================================
# END OF CONFIGURATION
# ============================================================================

